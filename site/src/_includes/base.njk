<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | USMGA</title>
  <meta name="description" content="United States Mounted Games Association public website.">
  <link rel="icon" href="/assets/img/thumbnail-untitled167-20240429205520.jpg" type="image/jpeg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&family=Open+Sans:wght@400;600;700&family=Patua+One&family=Raleway:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/styles.css">
</head>
<body class="no-js">
  <script>document.body.classList.remove('no-js');</script>
  <div class="header-wrap">
    <div class="nav-wrap">
      <div class="logo-bar">
        <a class="logo" href="/"><img src="/assets/img/thumbnail-untitled167-20240429205520.jpg" alt="USMGA"></a>
        <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">
          <span class="nav-toggle-bars" aria-hidden="true"></span>
        </button>
      </div>
      <nav class="menu" id="site-menu" aria-label="Primary navigation">
        <ul>
        {%- for item in navigation %}
          <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
        {%- endfor %}
        </ul>
      </nav>
      <div class="nav-backdrop" hidden></div>
    </div>

    {%- if hero %}
    <section class="hero{% if heroContain %} hero--contain{% endif %}" style="--hero-image: url('{{ hero }}');{% if heroPosition %} --hero-position: {{ heroPosition }};{% endif %}{% if heroHeight %} --hero-height: {{ heroHeight }};{% endif %}">
      {%- if heroTitle %}
      <div class="hero-inner">
        <h1 class="hero-title">{{ heroTitle }}</h1>
        {%- if heroSubtitle %}
        <p class="hero-sub">{{ heroSubtitle }}</p>
        {%- endif %}
      </div>
      {%- endif %}
    </section>
    {%- endif %}
  </div>

  <main id="main-wrap">
    <div class="container">
      {{ content | safe }}
    </div>
  </main>

  <footer class="site-footer">
    <p><strong>USMGA</strong></p>
    <p>Founded 1986</p>
    <ul class="social-links">
      <li><a href="https://www.facebook.com/share/g/1LcYjq6xzp/?mibextid=wwXIfr" aria-label="Facebook" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7H7.9v-2.94h2.54V9.85c0-2.52 1.49-3.92 3.77-3.92 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.9h2.78l-.45 2.94h-2.33v7C18.34 21.21 22 17.06 22 12.06Z"/></svg>
      </a></li>
      <li><a href="https://www.instagram.com/usmga.official?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==" aria-label="Instagram" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 5.18a4.66 4.66 0 1 0 0 9.32 4.66 4.66 0 0 0 0-9.32Zm0 7.69a3.03 3.03 0 1 1 0-6.06 3.03 3.03 0 0 1 0 6.06Zm5.94-7.87a1.09 1.09 0 1 1-2.18 0 1.09 1.09 0 0 1 2.18 0Z"/></svg>
      </a></li>
      <li><a href="mailto:usmga1042@gmail.com" aria-label="Email USMGA">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4.24-8 4.76-8-4.76V6l8 4.76L20 6v2.24Z"/></svg>
      </a></li>
    </ul>
  </footer>
  <script src="/assets/js/nav.js" defer></script>
  <script src="/assets/js/slideshow.js" defer></script>
</body>
</html>
