{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "Storage:ConnectionString": "UseDevelopmentStorage=true",
    "Storage:TableName": "SmsRequests",
